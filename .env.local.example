# The MÁV OTP2 GraphQL endpoint and the VPS proxy both upstreams are reached through.
# Copy to .env.local and fill in. .env.local is never committed. See plan/SPEC.md §1.
# All four are required: a missing one is a configuration error (SPEC.md §10 #2).

# The VPS proxy's root, which is also its MÁV route: every MÁV call is a POST of
# { url, headers, query } to it. The vagonweb calls POST { url, headers } to /vagonweb,
# resolved against this same address, so there is nothing else to configure.
PROXY_ENDPOINT=

# The MÁV endpoint, sent as the `url` field of that body.
GRAPHQL_ENDPOINT=

# The proxy sits behind Cloudflare Access, hence the service token.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
